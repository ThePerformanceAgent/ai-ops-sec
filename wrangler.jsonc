{
	// Cloudflare Workers com static assets: serve dist/ e aplica public/_headers.
	// Deploy pelo GitHub Actions (deploy.yml) com CLOUDFLARE_API_TOKEN limitado a Workers.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ai-ops-sec",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	},
	// Só o domínio canónico. www e andresilvalab.dev fazem 301 por Redirect Rules na zona
	// (o _redirects dos static assets só aceita origens relativas, não domínios).
	"routes": [{ "pattern": "andresilvalab.com", "custom_domain": true }],
	"workers_dev": false,
	"observability": { "enabled": false }
}
