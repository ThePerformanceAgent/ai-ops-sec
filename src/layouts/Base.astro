---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE, type Locale } from '../consts';
import { t } from '../lib/i18n';

interface Props {
	locale: Locale;
	title: string;
	description: string;
	image?: string;
	type?: 'website' | 'article';
	alternatePath?: string;
	published?: Date;
	modified?: Date;
	jsonLd?: object[];
	noindex?: boolean;
}
const { locale, alternatePath, ...head } = Astro.props;
const ui = t(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang={SITE[locale].locale}>
	<head>
		<BaseHead locale={locale} alternatePath={alternatePath} {...head} />
	</head>
	<body>
		<a class="skip" href="#main">{ui.skip}</a>
		<Header locale={locale} alternatePath={alternatePath} />
		<main id="main" class="wrap main">
			<slot />
		</main>
		<Footer locale={locale} />
		<script src={`${base}/js/theme.js`} defer is:inline></script>
	</body>
</html>

<style>
	.main {
		padding: clamp(2rem, 5vw, 4rem) 0 4rem;
		flex: 1;
	}
</style>
