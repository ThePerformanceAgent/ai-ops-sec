---
import Base from '../layouts/Base.astro';
import { href, site, t } from '../lib/i18n';
const ui = t('pt');
---

<Base locale="pt" title="404" description={site('pt').description} noindex>
	<section class="nf">
		<p class="seq-label">//404 not_found</p>
		<h1>{ui.not_found}</h1>
		<p class="lede">{ui.not_found_body} <span lang="en">{t('en').not_found_body}</span></p>
		<p><a class="btn" href={href('pt', '')}>{ui.back_home}</a> <a class="btn ghost" href={href('en', '')}>{t('en').back_home}</a></p>
	</section>
</Base>

<style>
	.nf h1 {
		margin: 0.6rem 0 1rem;
	}
</style>
