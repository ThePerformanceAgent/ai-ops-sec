---
/* Rodapé de prova: fontes, histórico, citação. A verificação factual fica no frontmatter (verified), não se mostra. */
import { AUTHOR, type Locale } from '../consts';
import { formatDate, t } from '../lib/i18n';
import { slugOf, versionOf, type Post } from '../lib/posts';

interface Props {
	post: Post;
	url: string;
}
const { post, url } = Astro.props;
const d = post.data;
const locale: Locale = d.lang;
const ui = t(locale);
const editUrl = `${AUTHOR.repo}/blob/main/src/content/posts/${post.id}.mdx`;
---

<footer class="proof">
	{d.sources.length > 0 && (
		<section class="card" aria-labelledby="sources" style="--i:3">
			<div class="stitle"><span class="idx">//</span><h2 id="sources">{ui.sources_title}</h2><span class="rule"></span><span class="hint">{d.sources.length}</span></div>
			<ol class="sources">
				{d.sources.map((s) => (
					<li>
						<a href={s.url} rel="noopener">{s.title}</a>
						{s.accessed && <span class="mono"> · {ui.accessed} {formatDate(s.accessed, locale)}</span>}
					</li>
				))}
			</ol>
		</section>
	)}
	{d.changelog.length > 0 && (
		<section class="card" aria-labelledby="changelog" style="--i:4">
			<div class="stitle"><span class="idx">//</span><h2 id="changelog">{ui.changelog_title}</h2><span class="rule"></span><span class="hint">{versionOf(post)}</span></div>
			<ol class="log mono">
				{d.changelog.map((c) => (
					<li><time datetime={c.date.toISOString()}>{formatDate(c.date, locale)}</time><span>{c.note}</span></li>
				))}
			</ol>
		</section>
	)}
	<section class="card cite" style="--i:5">
		<div class="stitle"><span class="idx">//</span><h2>{ui.cite}</h2><span class="rule"></span></div>
		<pre class="mono"><code>{AUTHOR.name}. "{d.title}". André Silva Lab, {formatDate(d.updatedDate ?? d.pubDate, locale)} ({versionOf(post)}). {url}</code></pre>
		<p class="mono"><a href={editUrl} rel="noopener">src/content/posts/{post.id}.mdx</a> · {slugOf(post)}</p>
	</section>
</footer>

<style>
	.proof {
		margin-top: 3rem;
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: var(--measure);
	}
	ul,
	ol {
		margin: 0;
		padding-left: 1.2em;
	}
	li + li {
		margin-top: 0.4em;
	}
	li::marker {
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.85em;
	}
	.verdict ul {
		color: var(--fg);
		font-size: 0.95rem;
	}
	.sources a {
		color: var(--fg);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
		text-underline-offset: 0.2em;
	}
	.sources a:hover {
		color: var(--accent);
	}
	.log {
		list-style: none;
		padding: 0;
	}
	.log li {
		display: grid;
		grid-template-columns: 7rem 1fr;
		gap: 1rem;
		color: var(--muted);
	}
	.log time {
		color: var(--faint);
	}
	.cite pre {
		background: var(--surface2);
		border: 1px solid var(--line);
		padding: 0.8em 1em;
		border-radius: 10px;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		color: var(--muted);
		margin: 0 0 0.5em;
	}
	.cite p {
		margin: 0;
	}
</style>
