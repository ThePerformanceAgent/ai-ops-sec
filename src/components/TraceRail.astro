---
/* A metadata do artigo como um trace, num cartão colado à esquerda: id, língua, leitura,
   datas, verificação, fontes, versão; depois as secções e as tags. */
import type { Locale } from '../consts';
import { areaOf } from '../lib/areas';
import { formatDate, href, isoDate, t } from '../lib/i18n';
import { readingMinutes, slugOf, versionOf, type Post } from '../lib/posts';

interface Props {
	post: Post;
	headings: { depth: number; slug: string; text: string }[];
	translation?: Post;
}
const { post, headings, translation } = Astro.props;
const d = post.data;
const locale: Locale = d.lang;
const ui = t(locale);
const minutes = readingMinutes(post.body);
const h2s = headings.filter((h) => h.depth === 2);
const area = areaOf(d.area);
---

<aside class="rail" aria-label={ui.trace}>
	<div class="card" style={`--i:1; --accent-dot: ${d.verifiedOn ? 'var(--accent)' : 'var(--amber)'}`}>
		<span class="seq-label">{ui.trace}</span>
		<dl class="mono">
			<dt>id</dt>
			<dd><b>{isoDate(d.pubDate)}/{slugOf(post)}</b></dd>
			<dt>{ui.in_area.toLowerCase()}</dt>
			<dd><a href={href(locale, `areas/${area.key}`)}>{area.name[locale]}</a></dd>
			<dt>lang</dt>
			<dd>{d.lang}{translation && <> · <a href={href(translation.data.lang, `blog/${slugOf(translation)}`)}>{translation.data.lang}</a></>}</dd>
			<dt>{ui.read}</dt>
			<dd>{minutes} {ui.min_read}</dd>
			<dt>{ui.published}</dt>
			<dd><time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate, locale)}</time></dd>
			{d.updatedDate && (
				<>
					<dt>{ui.updated}</dt>
					<dd><time datetime={d.updatedDate.toISOString()}>{formatDate(d.updatedDate, locale)}</time></dd>
				</>
			)}
			<dt>{ui.verified}</dt>
			<dd class={d.verifiedOn ? 'ok' : 'warn'}>{d.verifiedOn ? `✓ ${formatDate(d.verifiedOn, locale)}` : '·'}</dd>
			<dt>{ui.sources}</dt>
			<dd>{d.sources.length}</dd>
			<dt>ver</dt>
			<dd>{versionOf(post)}</dd>
		</dl>
	</div>
	{h2s.length > 1 && (
		<nav class="card toc" aria-label="Secções" style="--i:2">
			<span class="seq-label">{locale === 'pt' ? 'secções' : 'sections'}</span>
			<ol class="mono">
				{h2s.map((h, i) => (
					<li><a href={`#${h.slug}`}><span class="n">{String(i + 1).padStart(2, '0')}</span>{h.text}</a></li>
				))}
			</ol>
		</nav>
	)}
	<div class="tags">
		{d.tags.map((tag) => <a class="tag" href={href(locale, `tags/${tag}`)}>#{tag}</a>)}
	</div>
</aside>

<style>
	.rail {
		display: flex;
		flex-direction: column;
		gap: 12px;
		position: sticky;
		top: 4.5rem;
		align-self: start;
	}
	dl {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 6px 12px;
		margin: 10px 0 0;
	}
	dt {
		color: var(--faint);
	}
	dd {
		margin: 0;
		color: var(--muted);
		overflow-wrap: anywhere;
	}
	dd a,
	dd.ok {
		color: var(--accent);
	}
	dd.warn {
		color: var(--amber);
	}
	.toc ol {
		list-style: none;
		margin: 10px 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 7px;
	}
	.toc a {
		color: var(--muted);
		display: flex;
		gap: 8px;
		line-height: 1.4;
	}
	.toc a:hover {
		color: var(--fg);
	}
	.toc .n {
		color: var(--accent);
		flex: 0 0 auto;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		padding: 0 4px;
	}
	@media (max-width: 960px) {
		.rail {
			position: static;
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 12px;
		}
		.toc {
			display: none;
		}
		.tags {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 560px) {
		.rail {
			grid-template-columns: 1fr;
		}
	}
</style>
