<style>
	.cover {
		--anim-accent: var(--accent);
		--anim-soft: color-mix(in srgb, var(--accent) 55%, var(--fg));
		--anim-deep: color-mix(in srgb, var(--accent) 80%, var(--fg));
		--anim-ink: var(--fg);
		--anim-card: var(--surface3);
		--anim-bg: var(--bg);
		position: relative;
		overflow: hidden;
		border-radius: 12px;
		border: 1px solid var(--line);
		background: radial-gradient(120% 90% at 100% 0%, var(--accent-soft), transparent 60%), linear-gradient(135deg, var(--surface2), var(--surface));
		aspect-ratio: 200 / 120;
		width: 100%;
	}
	.cover.hero {
		border-radius: 16px;
		aspect-ratio: 200 / 120;
		max-height: 24rem;
	}
	.cover svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.cover::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(ellipse at center, transparent 60%, rgba(0, 0, 0, 0.25) 100%);
	}
	:global(:root[data-theme='light']) .cover::after {
		background: radial-gradient(ellipse at center, transparent 60%, rgba(16, 17, 23, 0.06) 100%);
	}
	.tf {
		animation: aa-tf 4s linear infinite;
	}
	.pc {
		animation: aa-pc 6s ease-in-out infinite;
	}
	.ds {
		animation: aa-ds 4s linear infinite;
	}
	.cb {
		animation: aa-cb 0.5s ease-out both;
	}
	.gs {
		animation: aa-gs 0.5s ease-out both;
	}
	.chip,
	.vis {
		transition: opacity 0.2s;
	}
	@keyframes aa-tf {
		0% { transform: translateX(0); opacity: 0; }
		8% { opacity: 1; }
		78% { opacity: 1; }
		88% { transform: translateX(180px); opacity: 0; }
		100% { transform: translateX(180px); opacity: 0; }
	}
	@keyframes aa-pc {
		0%, 100% { opacity: 0.55; }
		50% { opacity: 1; }
	}
	@keyframes aa-ds {
		0% { transform: translateY(-55%); }
		100% { transform: translateY(5%); }
	}
	@keyframes aa-cb {
		0% { opacity: 0; transform: translateY(4px); }
		100% { opacity: 1; transform: translateY(0); }
	}
	@keyframes aa-gs {
		0% { opacity: 0; transform: translateX(4px); }
		100% { opacity: 1; transform: translateX(0); }
	}
	@media (prefers-reduced-motion: reduce) {
		.tf, .pc, .ds, .cb, .gs { animation: none; }
	}
</style>
