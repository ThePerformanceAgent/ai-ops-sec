---
import Base from '../../layouts/Base.astro';
import PostRow from '../PostRow.astro';
import type { Locale } from '../../consts';
import { site, t } from '../../lib/i18n';
import { getPosts } from '../../lib/posts';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const ui = t(locale);
const posts = await getPosts(locale);
---

<Base locale={locale} title={ui.all_posts} description={site(locale).description} alternatePath="blog">
	<header class="head">
		<p class="seq-label">//{ui.nav_blog}</p>
		<h1>{ui.all_posts}</h1>
	</header>
	<section class="card" style="--i:1">
		<div class="stitle"><span class="idx">//</span><h2>{ui.latest}</h2><span class="rule"></span><span class="hint">{posts.length}</span></div>
		{posts.length === 0 ? <p class="empty">{ui.no_posts}</p> : <ul class="rows">{posts.map((p, i) => <PostRow post={p} index={i + 2} />)}</ul>}
	</section>
</Base>

<style>
	.head {
		margin-bottom: 1.4rem;
	}
	.head h1 {
		margin-top: 0.5rem;
	}
	.empty {
		color: var(--muted);
		margin: 0;
	}
</style>
