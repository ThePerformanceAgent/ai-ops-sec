---
import Base from '../../layouts/Base.astro';
import AreaCard from '../AreaCard.astro';
import PostRow from '../PostRow.astro';
import type { Locale } from '../../consts';
import { AREAS } from '../../lib/areas';
import { href, site, t } from '../../lib/i18n';
import { getPosts } from '../../lib/posts';
import { websiteLd } from '../../lib/seo';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const ui = t(locale);
const s = site(locale);
const all = await getPosts(locale);
const posts = all.slice(0, 6);
const countBy = (key: string) => all.filter((p) => p.data.area === key).length;
const siteUrl = new URL(href(locale, ''), Astro.site).toString();
const [l1, l2, l3, l4] = ui.hero_lines;
---

<Base locale={locale} title={s.title} description={s.description} alternatePath="" jsonLd={[websiteLd(locale, siteUrl)]}>
	<section class="hero">
		<div class="copy">
			<p class="seq-label reveal" style="--i:0">//00 {ui.hero_kicker}</p>
			<h1 class="reveal" style="--i:1">{l1}<br /><em>{l2}</em> {l3}<br />{l4}</h1>
			<p class="lede reveal" style="--i:2">{s.description}</p>
			<div class="cta reveal" style="--i:3">
				<a class="btn" href={href(locale, 'areas/ai-ops-sec')}>AI Ops Sec</a>
				<a class="btn ghost" href={href(locale, 'blog')}>{ui.all_posts}</a>
				<a class="btn ghost" href={href(locale, 'rss.xml')}>{ui.rss}</a>
			</div>
		</div>
		<svg class="trace reveal" style="--i:2" viewBox="0 0 320 120" preserveAspectRatio="none" aria-hidden="true">
			<path class="draw glow" pathLength="1" d="M0 96 C 24 96, 30 70, 48 72 S 74 92, 92 84 S 118 40, 140 44 S 166 88, 188 80 S 214 22, 236 30 S 262 60, 284 52 S 306 20, 320 18" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" />
			<path d="M0 96 C 24 96, 30 70, 48 72 S 74 92, 92 84 S 118 40, 140 44 S 166 88, 188 80 S 214 22, 236 30 S 262 60, 284 52 S 306 20, 320 18 L 320 120 L 0 120 Z" fill="url(#hero-fill)" opacity="0.5" />
			<defs>
				<linearGradient id="hero-fill" x1="0" x2="0" y1="0" y2="1">
					<stop offset="0" stop-color="var(--accent)" stop-opacity="0.25" />
					<stop offset="1" stop-color="var(--accent)" stop-opacity="0" />
				</linearGradient>
			</defs>
		</svg>
	</section>

	<section class="areas">
		<div class="stitle"><span class="idx">//</span><h2>{ui.areas_title}</h2><span class="rule"></span><span class="hint">{AREAS.length}</span></div>
		<div class="grid">
			{AREAS.map((a, i) => <AreaCard area={a} locale={locale} count={countBy(a.key)} index={i + 4} />)}
		</div>
	</section>

	<section class="latest card" style="--i:10">
		<div class="stitle"><span class="idx">//</span><h2>{ui.latest}</h2><span class="rule"></span><span class="hint">{posts.length.toString().padStart(2, '0')}</span></div>
		{posts.length === 0 ? <p class="empty">{ui.no_posts}</p> : <ul class="rows">{posts.map((p, i) => <PostRow post={p} index={i + 11} />)}</ul>}
	</section>

	<section class="built card" style="--i:12">
		<div class="stitle"><span class="idx">//</span><h2>{ui.how_built}</h2><span class="rule"></span></div>
		<ol class="mono">
			{ui.how_built_items.map((item, i) => (
				<li><span class="n">{String(i + 1).padStart(2, '0')}</span><span>{item}</span></li>
			))}
		</ol>
	</section>
</Base>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
		gap: 2rem;
		align-items: end;
		padding: clamp(0.5rem, 3vw, 2rem) 0 clamp(2.5rem, 6vw, 4.5rem);
	}
	.hero h1 {
		margin: 0.8rem 0 1.2rem;
		font-size: clamp(2rem, 4.2vw, 3.3rem);
	}
	.cta {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
		margin-top: 1.6rem;
	}
	.trace {
		width: 100%;
		height: 9rem;
		overflow: visible;
	}
	.areas {
		margin-bottom: 1.2rem;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 12px;
	}
	.latest,
	.built {
		margin-top: 12px;
	}
	.empty {
		color: var(--muted);
		margin: 0;
		max-width: 52ch;
	}
	.built ol {
		list-style: none;
		margin: 6px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 12px 28px;
		font-size: 12px;
		color: var(--muted);
		line-height: 1.6;
	}
	.built li {
		display: flex;
		gap: 10px;
	}
	.built .n {
		color: var(--accent);
		flex: 0 0 auto;
	}
	@media (max-width: 860px) {
		.hero {
			grid-template-columns: 1fr;
		}
		.trace {
			height: 6rem;
		}
	}
</style>
