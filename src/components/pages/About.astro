---
import Base from '../../layouts/Base.astro';
import { AUTHOR, type Locale } from '../../consts';
import { href, site, t } from '../../lib/i18n';
import { profilePageLd } from '../../lib/seo';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const ui = t(locale);
const s = site(locale);
const pt = locale === 'pt';
const url = new URL(Astro.url.pathname, Astro.site).toString();

const eras = pt
	? [
			{ seq: '01', title: 'Da clínica ao digital (2004 a 2010)', body: 'Comecei numa clínica de medicina desportiva, no chão da operação, como assistente de fisioterapia. Em 2006 passei a tratar do meio digital e da cadeia de abastecimento da mesma casa. Aprendi cedo que um processo que depende de uma pessoa lembrar-se é um processo que falha.' },
			{ seq: '02', title: 'Performance marketing (2009 a 2021)', body: 'Onze anos a gerir PPC e marketing digital na Clínica do Dragão, centro médico de excelência da FIFA, e na sua academia. Analytics, BI, forecasting, streaming de jornadas científicas. Google Ads Product Specialist. Quanto mais campanhas optimizava, mais processos manuais encontrava à volta: reporting que demorava horas, dados copiados entre sistemas, decisões por intuição.' },
			{ seq: '03', title: 'Escala e equipa (2021 a 2025)', body: 'Na Wise Pirates: contas de banca, cosmética, indústria e saúde como senior PPC, e depois a liderar uma equipa de 18 campaign managers com a missão de pôr cada decisão a assentar em dados. R&D em gestão avançada de feeds. Formador de Google Ads e Google Shopping na WIT Academy. Foi aqui que decidi automatizar tudo o que era repetível.' },
			{ seq: '04', title: 'Automação e IA agêntica (2025 até hoje)', body: 'Head of Process Automation & Agentic desde Maio de 2025 e Operational Board Member desde Junho de 2026, no eixo de tecnologia e infraestrutura. Agentes com ferramentas, memória, supervisão e limites explícitos; uma engine de conhecimento (Prism) que transforma cada projecto em padrões reutilizáveis; servidores MCP; e o pipeline que produz este laboratório. A pergunta deixou de ser "funciona?" e passou a ser "é seguro, é observável e prova valor?".' },
		]
	: [
			{ seq: '01', title: 'From the clinic to digital (2004 to 2010)', body: 'I started at a sports medicine clinic, on the operations floor, as a physical therapist assistant. In 2006 I took over digital media and the supply chain of the same house. I learned early that a process that depends on someone remembering is a process that fails.' },
			{ seq: '02', title: 'Performance marketing (2009 to 2021)', body: 'Eleven years running PPC and digital marketing at Clínica do Dragão, a FIFA Medical Centre of Excellence, and its academy. Analytics, BI, forecasting, live streaming of scientific conferences. Google Ads Product Specialist. The more campaigns I optimised, the more manual processes I found around them: reporting that took hours, data copied between systems, decisions by gut feeling.' },
			{ seq: '03', title: 'Scale and team (2021 to 2025)', body: 'At Wise Pirates: banking, cosmetics, industry and healthcare accounts as senior PPC, then leading a team of 18 campaign managers with one mission: every decision grounded in data. R&D on advanced feed management. Google Ads and Google Shopping trainer at WIT Academy. This is where I decided to automate everything repeatable.' },
			{ seq: '04', title: 'Automation and agentic AI (2025 to today)', body: 'Head of Process Automation & Agentic since May 2025 and Operational Board Member since June 2026, on the technology and infrastructure track. Agents with tools, memory, supervision and explicit limits; a knowledge engine (Prism) that turns every project into reusable patterns; MCP servers; and the pipeline that produces this lab. The question stopped being "does it work?" and became "is it safe, observable, and does it prove value?".' },
		];

const builds = pt
	? [
			['Agentes com travões', 'Whitelist de ferramentas, validação de output antes de acções irreversíveis, kill switch, políticas de acesso por agente.'],
			['Observabilidade por defeito', 'Logs estruturados, trace por execução, métricas e alertas que acordam antes do cliente reclamar.'],
			['Automação que prova valor', 'Cada automação tem de mostrar euros poupados ou horas recuperadas. Menos teatro, mais produção.'],
			['Produtização', 'Transformar o que funciona num cliente em produto repetível: engine de conhecimento, servidores MCP, pipelines de reporting, agentes de orçamento.'],
		]
	: [
			['Agents with brakes', 'Tool whitelists, output validation before irreversible actions, kill switch, per-agent access policies.'],
			['Observability by default', 'Structured logs, a trace per run, metrics and alerts that wake up before the client complains.'],
			['Automation that proves value', 'Every automation must show euros saved or hours recovered. Less theatre, more production.'],
			['Productisation', 'Turning what works for one client into a repeatable product: knowledge engine, MCP servers, reporting pipelines, quoting agents.'],
		];

const timeline = pt
	? [
			{ y: '2026', role: 'Operational Board Member', org: 'Wise Pirates', note: 'eixo de tecnologia e infraestrutura' },
			{ y: '2025', role: 'Head of Process Automation & Agentic', org: 'Wise Pirates', note: 'unidade de automação e IA agêntica' },
			{ y: '2025', role: 'Pós-graduação AI Agents Manager and Programming', org: 'NoCode StartUp', note: 'formação' },
			{ y: '2022 a 2025', role: 'PPC Team Leader', org: 'Wise Pirates', note: '18 campaign managers · R&D em gestão avançada de feeds' },
			{ y: '2022', role: 'Formador', org: 'WIT Academy', note: 'Google Ads, Google Shopping, Digital Activation (até hoje)' },
			{ y: '2021', role: 'Senior PPC Campaign Manager', org: 'Wise Pirates', note: 'banca, cosmética, indústria, saúde (até hoje)' },
			{ y: '2021', role: 'Fundador', org: 'The Performance Agent', note: 'consultoria própria (até hoje)' },
			{ y: '2021', role: 'Marketing e transformação digital', org: 'Grupo Sausport', note: 'e-commerce manager' },
			{ y: '2020 a 2024', role: 'Google Ads Product Specialist (Bronze)', org: 'Google', note: 'programa de especialistas' },
			{ y: '2012 a 2021', role: 'PPC Manager · Formador e coordenador de marketing digital', org: 'Academia Clínica do Dragão', note: 'curso para nutricionistas em 2021' },
			{ y: '2009 a 2021', role: 'PPC Manager · Online Marketing Manager · Head of Digital Marketing', org: 'Clínica do Dragão, FIFA Medical Centre of Excellence', note: 'streaming das Jornadas Saúde Atlântica, 2014 a 2021' },
			{ y: '2006 a 2021', role: 'Head of Digital Media · Head of Supply', org: 'Clínica Espregueira-Mendes', note: 'meio digital e cadeia de abastecimento' },
			{ y: '2004 a 2010', role: 'Assistente de fisioterapia', org: 'Clínica Espregueira-Mendes', note: 'onde tudo começou' },
		]
	: [
			{ y: '2026', role: 'Operational Board Member', org: 'Wise Pirates', note: 'technology and infrastructure track' },
			{ y: '2025', role: 'Head of Process Automation & Agentic', org: 'Wise Pirates', note: 'automation and agentic AI unit' },
			{ y: '2025', role: 'Postgraduate specialisation, AI Agents Manager and Programming', org: 'NoCode StartUp', note: 'education' },
			{ y: '2022 to 2025', role: 'PPC Team Leader', org: 'Wise Pirates', note: '18 campaign managers · R&D on advanced feed management' },
			{ y: '2022', role: 'Trainer', org: 'WIT Academy', note: 'Google Ads, Google Shopping, Digital Activation (to date)' },
			{ y: '2021', role: 'Senior PPC Campaign Manager', org: 'Wise Pirates', note: 'banking, cosmetics, industry, healthcare (to date)' },
			{ y: '2021', role: 'Founder', org: 'The Performance Agent', note: 'own consultancy (to date)' },
			{ y: '2021', role: 'Marketing and digital transformation', org: 'Sausport Group', note: 'e-commerce manager' },
			{ y: '2020 to 2024', role: 'Google Ads Product Specialist (Bronze)', org: 'Google', note: 'specialist programme' },
			{ y: '2012 to 2021', role: 'PPC Manager · Digital marketing trainer and coordinator', org: 'Academia Clínica do Dragão', note: 'course for nutritionists in 2021' },
			{ y: '2009 to 2021', role: 'PPC Manager · Online Marketing Manager · Head of Digital Marketing', org: 'Clínica do Dragão, FIFA Medical Centre of Excellence', note: 'live streaming of Jornadas Saúde Atlântica, 2014 to 2021' },
			{ y: '2006 to 2021', role: 'Head of Digital Media · Head of Supply', org: 'Clínica Espregueira-Mendes', note: 'digital media and supply chain' },
			{ y: '2004 to 2010', role: 'Physical therapist assistant', org: 'Clínica Espregueira-Mendes', note: 'where it all started' },
		];

const stack = ['n8n', 'MCP', 'Claude', 'Python', 'TypeScript', 'Supabase', 'Qdrant', 'Railway', 'Cloudflare', 'Google Ads', 'Meta Ads', 'OpenTelemetry'];
---

<Base locale={locale} title={ui.nav_about} description={s.description} alternatePath="about" jsonLd={[profilePageLd(locale, url)]}>
	<article class="about">
		<header class="reveal" style="--i:0">
			<p class="seq-label">//{ui.nav_about}</p>
			<h1>
				{pt ? (
					<>Mais de vinte anos a transformar dados em decisões. Hoje, <em>agentes em produção</em>.</>
				) : (
					<>Twenty-plus years turning data into decisions. Today, <em>agents in production</em>.</>
				)}
			</h1>
			<p class="lede">
				{pt
					? 'Sou o André Silva. Trabalho em automação de processos e IA agêntica na Wise Pirates, no Porto. Este laboratório é onde documento, com prova, o que aprendo a pôr agentes a trabalhar em empresas reais.'
					: 'I am André Silva. I work in process automation and agentic AI at Wise Pirates, in Porto, Portugal. This lab is where I document, with evidence, what I learn putting agents to work in real companies.'}
			</p>
		</header>

		<section class="card today" style="--i:1; --accent-dot: var(--accent)">
			<div class="stitle"><span class="idx">//</span><h2>{pt ? 'Hoje: Wise Pirates' : 'Today: Wise Pirates'}</h2><span class="rule"></span><span class="hint">Porto</span></div>
			<div class="today-grid">
				<div class="prose">
					{pt ? (
						<>
							<p>
								Na <a href={AUTHOR.company.url} rel="noopener">Wise Pirates</a>, agência de marketing digital orientada a dados (desde 2017, mais de 100 pessoas e 500 marcas servidas), lidero a unidade de <strong>Process Automation &amp; Agentic AI</strong> e integro a direcção operacional com o eixo de tecnologia e infraestrutura.
							</p>
							<p>
								O trabalho da unidade é pôr a inteligência a correr, não a ficar num relatório: workflows de automação empresarial, agentes especializados com RAG, memória e supervisão, pipelines de dados com observabilidade, e a camada de segurança que os deixa entrar em produção. Sou também formador de Google Ads e Google Shopping na WIT Academy. É na Wise que aplico o que escrevo aqui, e é lá que me encontras para trabalhar.
							</p>
						</>
					) : (
						<>
							<p>
								At <a href={AUTHOR.company.url} rel="noopener">Wise Pirates</a>, a data-driven digital marketing agency (since 2017, 100+ people and 500+ brands served), I lead the <strong>Process Automation &amp; Agentic AI</strong> unit and sit on the operational leadership with the technology and infrastructure axis.
							</p>
							<p>
								The unit's job is to make intelligence run instead of sitting in a report: business automation workflows, specialised agents with RAG, memory and supervision, data pipelines with observability, and the security layer that lets them into production. I also train Google Ads and Google Shopping at WIT Academy. Wise is where I apply what I write here, and where you can find me to work together.
							</p>
						</>
					)}
				</div>
				<div class="find">
					<span class="seq-label">{pt ? 'onde me encontrar' : 'where to find me'}</span>
					<a class="btn" href={AUTHOR.company.contact} rel="noopener">Wise Pirates</a>
					<a class="btn ghost" href={AUTHOR.linkedin} rel="me noopener">LinkedIn</a>
					<a class="btn ghost" href={AUTHOR.github} rel="me noopener">GitHub</a>
					<p class="mono">{pt ? 'Trabalho e propostas pela Wise Pirates. Conversas técnicas no LinkedIn.' : 'Work and proposals through Wise Pirates. Technical conversations on LinkedIn.'}</p>
				</div>
			</div>
		</section>

		<section class="path">
			<div class="stitle"><span class="idx">//</span><h2>{pt ? 'Percurso' : 'Path'}</h2><span class="rule"></span><span class="hint">{pt ? 'quatro eras, uma direcção' : 'four eras, one direction'}</span></div>
			<ol class="eras">
				{eras.map((e, i) => (
					<li class="card era" style={`--i:${i + 2}`}>
						<span class="seq-label">//{e.seq}</span>
						<h3>{e.title}</h3>
						<p>{e.body}</p>
					</li>
				))}
			</ol>
		</section>

		<section class="card timeline" style="--i:6">
			<div class="stitle"><span class="idx">//</span><h2>{pt ? 'Cronologia' : 'Timeline'}</h2><span class="rule"></span><span class="hint">2004 → {new Date().getFullYear()}</span></div>
			<ol class="tl">
				{timeline.map((t) => (
					<li>
						<span class="mono y"><b>{t.y}</b></span>
						<span class="what"><span class="role">{t.role}</span><span class="org mono">{t.org}</span>{t.note && <span class="note">{t.note}</span>}</span>
					</li>
				))}
			</ol>
			<p class="mono src">{pt ? 'Fonte: perfil LinkedIn, Setembro de 2026. Prémios internos: The Performance Pirate, The Trainer (duas vezes), The Resilient, Prémio Dedicação.' : 'Source: LinkedIn profile, September 2026. Internal awards: The Performance Pirate, The Trainer (twice), The Resilient, Dedication Award.'}</p>
		</section>

		<section class="grid2">
			<div class="card" style="--i:7">
				<div class="stitle"><span class="idx">//</span><h2>{pt ? 'O que construo' : 'What I build'}</h2><span class="rule"></span></div>
				<dl class="builds">
					{builds.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
				</dl>
				<div class="stack">{stack.map((x) => <span class="tag">{x}</span>)}</div>
			</div>
			<aside class="verdict" style="--i:8">
				<span class="seq-label kicker">{pt ? 'regras da casa' : 'house rules'}</span>
				<ul>
					{pt ? (
						<>
							<li><b>Security AI first.</b> Guardrails e limites desde o primeiro dia. Um agente em produção sem controlo é uma bomba-relógio.</li>
							<li><b>Observabilidade por defeito.</b> Se não consegues monitorizar, não devias ter em produção.</li>
							<li><b>Orientação a ROI.</b> Métricas que importam, não dashboards bonitos.</li>
							<li><b>Higiene epistémica.</b> Cada afirmação tem fonte. Uma afirmação forte exige um método forte: se só fiz grep, digo que só fiz grep.</li>
							<li>Falhas de terceiros só depois de divulgação responsável. Erros corrigem-se em público, no histórico de cada artigo.</li>
						</>
					) : (
						<>
							<li><b>Security AI first.</b> Guardrails and limits from day one. An uncontrolled agent in production is a time bomb.</li>
							<li><b>Observability by default.</b> If you cannot monitor it, it should not be in production.</li>
							<li><b>ROI first.</b> Metrics that matter, not pretty dashboards.</li>
							<li><b>Epistemic hygiene.</b> Every claim has a source. A strong claim needs a strong method: if all I did was grep, I say I only grepped.</li>
							<li>Third-party vulnerabilities only after responsible disclosure. Mistakes are fixed in public, in each article's history.</li>
						</>
					)}
				</ul>
			</aside>
		</section>

		<p class="mono foot">
			{pt ? 'Este site: ' : 'This site: '}<a href={AUTHOR.repo} rel="noopener">{ui.footer_source}</a> · <a href={href(locale, 'areas')}>{ui.areas_title}</a> · <a href={href(locale, 'rss.xml')}>RSS</a>
		</p>
	</article>
</Base>

<style>
	header {
		margin-bottom: 1.6rem;
		max-width: 60rem;
	}
	header h1 {
		margin-top: 0.5rem;
	}
	.today {
		margin-bottom: 1.6rem;
	}
	.today-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
		gap: 1.5rem 2.5rem;
		align-items: start;
	}
	.today .prose {
		font-size: 0.98rem;
	}
	.today .prose p:last-child {
		margin-bottom: 0;
	}
	.find {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 8px;
		padding: 14px;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: var(--surface2);
	}
	.find .btn {
		width: 100%;
		justify-content: center;
	}
	.find .mono {
		margin: 4px 0 0;
	}
	.path {
		margin-bottom: 1.6rem;
	}
	.eras {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 12px;
	}
	.era h3 {
		margin: 6px 0 8px;
	}
	.era p {
		margin: 0;
		color: var(--muted);
		font-size: 0.92rem;
	}
	.timeline {
		margin-bottom: 12px;
	}
	.tl {
		list-style: none;
		margin: 6px 0 0;
		padding: 0;
	}
	.tl li {
		display: grid;
		grid-template-columns: 7.5rem 1fr;
		gap: 0.4rem 1.2rem;
		padding: 10px 0;
		border-top: 1px solid var(--line);
		align-items: baseline;
	}
	.tl li:first-child {
		border-top: 0;
		padding-top: 0;
	}
	.tl .y b {
		color: var(--accent);
	}
	.tl .what {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 10px;
		align-items: baseline;
	}
	.tl .role {
		font-weight: 600;
	}
	.tl .org {
		color: var(--muted);
	}
	.tl .note {
		flex-basis: 100%;
		color: var(--muted);
		font-size: 0.86rem;
	}
	.src {
		margin: 12px 0 0;
		padding-top: 10px;
		border-top: 1px solid var(--line);
	}
	@media (max-width: 640px) {
		.tl li {
			grid-template-columns: 1fr;
			gap: 2px;
		}
	}
	.grid2 {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
		gap: 12px;
		align-items: start;
	}
	.builds {
		margin: 4px 0 14px;
		display: grid;
		grid-template-columns: 1fr;
		gap: 10px;
	}
	.builds dt {
		font-weight: 600;
	}
	.builds dd {
		margin: 2px 0 0;
		color: var(--muted);
		font-size: 0.92rem;
	}
	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		padding-top: 12px;
		border-top: 1px solid var(--line);
	}
	.verdict ul {
		margin: 0;
		padding-left: 1.1em;
		color: var(--fg);
		font-size: 0.93rem;
	}
	.verdict li + li {
		margin-top: 0.55em;
	}
	.foot {
		margin: 1.6rem 0 0;
	}
	@media (max-width: 860px) {
		.today-grid,
		.grid2 {
			grid-template-columns: 1fr;
		}
	}
</style>
